section
  h1 Ladda upp nytt recept 

  form action="/recipe/create" method="post" 
    input type="text" name="title" placeholder="Titel"
    br/
    textarea name="description" cols="80" placeholder="Beskrivning"
    br/
    #ingredients
      .ingredient
        input type="text" name="ingredients[][amount]" placeholder="Mängd"
        input type="text" name="ingredients[][name]" placeholder="Ingrediens"
        button type="button" onclick="removeIngredient(this)" ❌
    br/
    button type="button" onclick="addIngredient()" Lägg till ingrediens
    br/
    textarea name="instructions" cols="80" placeholder="Instruktioner"
    br/
    input type="submit" value="post"

  script type="text/javascript"
    |
      window.addIngredient = function() {
        const container = document.getElementById("ingredients");

        const div = document.createElement("div");
        div.className = "ingredient";

        div.innerHTML = `
          <input type="text" name="ingredients[][amount]" placeholder="Mängd">
          <input type="text" name="ingredients[][name]" placeholder="Ingrediens">
          <button type="button" onclick="removeIngredient(this)">❌</button>
        `;

        container.appendChild(div);
      };

      window.removeIngredient = function(button) {
        button.parentElement.remove();
      };